# Firebase — obligatorias (ya las tienes en .env)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# OpenRouter — opcional, solo para comparar modelos en el panel Lab IA
# Obtener en: https://openrouter.ai → API Keys
VITE_OPENROUTER_API_KEY=

# Gemini API key — CLI (scripts) y front en modo "Gemini API (local)"
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Misma clave que GEMINI_API_KEY; expone la key en el browser (solo dev/local)
VITE_GEMINI_API_KEY=
