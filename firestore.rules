rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authenticated users can read/write campaigns
    match /campaigns/{campaignId} {
      allow read, write: if request.auth != null;
    }

    match /maps/{mapId} {
      allow read, write: if request.auth != null;
    }

    match /locations/{locationId} {
      allow read, write: if request.auth != null;
    }

    match /characters/{characterId} {
      allow read, write: if request.auth != null;
    }

    match /encyclopedia/{entryId} {
      allow read, write: if request.auth != null;
    }

    match /abilities/{abilityId} {
      allow read, write: if request.auth != null;
    }

    match /players/{playerId} {
      allow read, write: if request.auth != null;
    }

    // Shared real-time game session: party position, music, etc.
    // One document per campaign — any authenticated user in the session can read/write.
    match /game/{campaignId} {
      allow read, write: if request.auth != null;
    }
  }
}