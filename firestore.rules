rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns true if the current user has role "dm" in the players collection.
    function isDM() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/players/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role == "dm";
    }

    function playerExists() {
      return exists(/databases/$(database)/documents/players/$(request.auth.uid));
    }

    function playerData() {
      return get(/databases/$(database)/documents/players/$(request.auth.uid)).data;
    }

    function characterData(charId) {
      return get(/databases/$(database)/documents/characters/$(charId)).data;
    }

    /** Same idea as canControlToken — owner, roster, or explicit control list. */
    function controlsCharacter(charId) {
      return isAuthenticated()
        && charId is string
        && charId.size() > 0
        && exists(/databases/$(database)/documents/characters/$(charId))
        && (
          characterData(charId).ownerPlayerId == request.auth.uid
          || (
            playerExists()
            && "activeCharacterId" in playerData()
            && playerData().activeCharacterId == charId
          )
          || (
            playerExists()
            && "characterIds" in playerData()
            && playerData().characterIds is list
            && charId in playerData().characterIds
          )
          || (
            "controlledByPlayerIds" in characterData(charId)
            && characterData(charId).controlledByPlayerIds is list
            && request.auth.uid in characterData(charId).controlledByPlayerIds
          )
        );
    }

    function wikiLinkedCharacterId(data) {
      return ("linkedVttCharacterId" in data)
        && data.linkedVttCharacterId is string
        && data.linkedVttCharacterId.size() > 0
        ? data.linkedVttCharacterId
        : "";
    }

    function canCreateLinkedPersonaje() {
      return request.resource.data.entityType == "personaje"
        && request.resource.data.visibility == "players"
        && wikiLinkedCharacterId(request.resource.data) != ""
        && controlsCharacter(wikiLinkedCharacterId(request.resource.data));
    }

    /**
     * Player may update a PERSONAJE they control: already linked, or claim an
     * unlinked ficha by setting linkedVttCharacterId to their character.
     * Visibility / entityType must not change.
     */
    function canPlayerUpdatePersonaje() {
      let nextLink = wikiLinkedCharacterId(request.resource.data);
      let prevLink = wikiLinkedCharacterId(resource.data);
      return nextLink != ""
        && controlsCharacter(nextLink)
        && resource.data.entityType == "personaje"
        && request.resource.data.entityType == "personaje"
        && request.resource.data.visibility == resource.data.visibility
        && (prevLink == "" || prevLink == nextLink);
    }

    // ── Campaigns ─────────────────────────────────────────────────────────────

    match /campaigns/{campaignId} {
      // Authenticated read (UI filters membership). Tight list queries + client
      // filter keep eval missions (access/owner_only) off other players' selectors.
      allow read: if isAuthenticated();
      allow write: if isDM() || (
        isAuthenticated() && resource.data.ownerId == request.auth.uid
      );

      // wikiEntities: players read "players" visibility; may update/create own linked PERSONAJE
      match /wikiEntities/{entityId} {
        allow read: if isDM() ||
          (isAuthenticated() && resource.data.visibility == "players");

        allow create: if isDM() || canCreateLinkedPersonaje();

        allow update: if isDM() || canPlayerUpdatePersonaje();

        allow delete: if isDM();
      }

      // DM-only secret notes for AI / prep — never readable by players
      match /entityDmNotes/{entityId} {
        allow read, write: if isDM();
      }

      // entityRelations: all authenticated users read; only DMs write
      match /entityRelations/{relationId} {
        allow read: if isAuthenticated();
        allow write: if isDM();
      }

      // Campaign missions (generic + personal). Authenticated list/listen is
      // allowed (same pattern as entityRelations); UI hides status=hidden and
      // scopes personal missions to the open dossier character.
      match /missions/{missionId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isDM();
      }

      // Unique RE4 items. List/listen must be query-safe (no resource.data
      // filters on collection queries — same pattern as missions). Vault stays
      // DM-write; players may only rearrange gx/gy/rot on items they control.
      match /items/{itemId} {
        allow read: if isAuthenticated();

        allow create, delete: if isDM();

        allow update: if isDM() || (
          isAuthenticated()
          && resource.data.ownerType == "character"
          && request.resource.data.ownerType == "character"
          && resource.data.ownerCharacterId is string
          && request.resource.data.ownerCharacterId == resource.data.ownerCharacterId
          && controlsCharacter(resource.data.ownerCharacterId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(["gx", "gy", "rot", "equippedSlot", "updatedAt", "updatedBy"])
        );
      }

      match /aiThreads/{threadId} {
        allow read, write: if isDM();
        match /messages/{messageId} {
          allow read, write: if isDM();
        }
      }

      match /sessions/{sessionId} {
        allow read: if isAuthenticated();
        allow write: if isDM();
      }

      match /messages/{messageId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if isDM();
      }
    }

    match /maps/{mapId} {
      allow read, write: if isAuthenticated();
    }

    match /locations/{locationId} {
      allow read, write: if isAuthenticated();
    }

    match /characters/{characterId} {
      allow read, write: if isAuthenticated();
    }

    // Legacy lore entries — read-only for migration period; DM can still create/update
    match /encyclopedia/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isDM();
    }

    match /abilities/{abilityId} {
      allow read, write: if isAuthenticated();
    }

    // Combat / status tags (ICON core + campaign custom)
    match /tags/{tagId} {
      allow read: if isAuthenticated();
      allow write: if isDM();
    }

    // ICON jobs / classes
    match /clases/{classId} {
      allow read, write: if isAuthenticated();
      match /abilities/{abilitySlotId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /players/{playerId} {
      allow read, write: if isAuthenticated();
    }

    // Shared real-time game session
    match /game/{campaignId} {
      allow read, write: if isAuthenticated();
    }
  }
}
